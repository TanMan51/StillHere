# Copy to backend/.env and fill in. Owner: Person A. Never commit .env.

# SQLite file by default; any SQLAlchemy URL works.
# DATABASE_URL=sqlite:///./stillhere.db

HOUSEHOLD_TZ=America/New_York

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Devices and their tokens. Leave unset to use the dev defaults (token "dev-<device id>").
# DEVICES_JSON=[{"id":"fridge-1","name":"Mom's fridge","object_type":"fridge","token":"change-me"}]

# Demo clock speed: 1440 means 12 hours pass in 30 real seconds.
DEMO_TIME_SCALE=1440

# Twilio. While any of these is blank, texts are only logged (dry run).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
