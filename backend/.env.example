# Copy to backend/.env and fill in. Owner: Person A. Never commit .env.

# SQLite file by default; any SQLAlchemy URL works.
# DATABASE_URL=sqlite:///./stillhere.db
# On Railway, attach a volume at /data and set DATABASE_URL=sqlite:////data/stillhere.db

HOUSEHOLD_TZ=America/New_York

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Devices and their tokens. Leave unset to use the dev defaults (token "dev-<device id>").
# DEVICES_JSON=[{"id":"fridge-1","name":"Mom's fridge","object_type":"fridge","token":"change-me"}]

# Accounts. SECRET_KEY signs login tokens: set a long random value when deployed, or everyone
# is logged out whenever the server restarts. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SESSION_HOURS=12
# true: dashboard endpoints reject requests without a login token. false keeps them open.
AUTH_REQUIRED=false
# Seeds Maple Grove Senior Living with invented residents and two demo accounts
# (demo@stillhere.example as family, staff@maplegrove.example as provider).
SEED_DEMO_COMMUNITY=true
# Password for both demo accounts. They hold invented data only.
DEMO_PASSWORD=stillhere-demo

# Demo clock speed: 1440 means 12 hours pass in 30 real seconds.
DEMO_TIME_SCALE=1440

# SimpleTexting. When the API key is set, texts go through SimpleTexting instead of Twilio.
# FROM_NUMBER is optional (defaults to the account's primary number), 10 digits like 4045550123.
SIMPLETEXTING_API_KEY=
SIMPLETEXTING_FROM_NUMBER=

# Textbelt, a paid SMS API with no carrier registration. Used when set and SimpleTexting isn't.
TEXTBELT_API_KEY=

# Weather-aware check-ins from the National Weather Service (free, no key). While a heat or
# cold advisory is out for the community's location, grid thresholds shrink by the factor.
WEATHER_ENABLED=true
WEATHER_REFRESH_SECONDS=900
# The NWS asks for a contact in the User-Agent, e.g. "StillHere (you@example.com)".
WEATHER_USER_AGENT=StillHere (HackGT demo)
WEATHER_THRESHOLD_FACTOR=0.5

# Seconds without a heartbeat before a device counts as offline (default 2 hours). Lower it
# for a live demo so unplugging the sensor turns its apartment gray; keep it above 90.
OFFLINE_AFTER_SECONDS=7200

# Seconds to wait for "I'm okay" after a loud sound or fall. Lower it only for testing.
REPLY_WINDOW_SECONDS=30

# Twilio. While no provider is set up, texts are only logged (dry run).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email fallback, used when no SMS provider works. ALERT_EMAILS is comma-separated.
# RESEND_API_KEY (resend.com) sends over HTTPS; use it on Railway, which blocks SMTP.
# On Resend's free tier, ALERT_EMAILS can only be the address you signed up with.
RESEND_API_KEY=
# For Gmail, SMTP_PASSWORD is an app password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAILS=
